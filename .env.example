# =====================================================================
# Kurumsal RAG — örnek yapılandırma. `.env` olarak kopyalayın.
# =====================================================================

# --- Google GenAI (https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.5-flash
FAST_LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
# Şemaya sabitlenir: değiştirmek yeni bir migration gerektirir
EMBEDDING_DIMENSION=768
LLM_TEMPERATURE=0.1

# Sağlayıcılar: üretimde gemini. Anahtarsız yerel deneme için:
#   EMBEDDING_PROVIDER=hashing  (anlamsal değildir, yalnızca geliştirme)
#   LLM_PROVIDER=none           (yanıt üretilmez, yalnızca kanıtlar döner)
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini

# --- REST API ---
ENVIRONMENT=development
# Tenant oluşturma uç noktası (POST /api/v1/admin/tenants) için; uzun ve rastgele olmalı
ADMIN_API_KEY=change-me-to-a-long-random-string
RATE_LIMIT_PER_MINUTE=60
# Kullanıcı oturumları (migration 0003)
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
INVITATION_TTL_HOURS=72
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=10
ALLOW_SIGNUP=true
CORS_ORIGINS=[]
LOG_LEVEL=INFO

# --- PostgreSQL + pgvector ---
# Uygulama RLS'e tabi, superuser OLMAYAN rolle bağlanır
DATABASE_URL=postgresql+asyncpg://rag_app:degistirin-baska-uzun-rastgele-parola@localhost:5432/rag
# Migration'lar tablo sahibi rolle çalışır
DATABASE_MIGRATION_URL=postgresql+asyncpg://rag_admin:degistirin-uzun-rastgele-parola@localhost:5432/rag
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
PGVECTOR_ITERATIVE_SCAN=true

# --- Redis (rate limit) ---
REDIS_URL=redis://localhost:6379/0

# --- docker compose parolaları ---
POSTGRES_PASSWORD=degistirin-uzun-rastgele-parola
APP_DB_PASSWORD=degistirin-baska-uzun-rastgele-parola

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval ---
TOP_K=5
CANDIDATE_K=20
RRF_K=60
VECTOR_WEIGHT=1.0
BM25_WEIGHT=1.0
USE_LLM_RERANKER=true
MIN_RELEVANCE=0.30
QUERY_REWRITING=true
HISTORY_TURNS=4

MAX_FILE_SIZE_MB=25

# --- Analitik (Text-to-SQL) ---
ANALYTICS_READONLY_ROLE=rag_readonly
ANALYTICS_MAX_ROWS=500
ANALYTICS_STATEMENT_TIMEOUT_MS=5000
ANALYTICS_MAX_ATTEMPTS=3
# Üretimde false yapın
ENABLE_DEMO_DATA=true
